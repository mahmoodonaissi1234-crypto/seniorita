// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  gender      String
  description String
  createdAt   DateTime @default(now())
  items       Item[]
}

model Item {
  id           Int           @id @default(autoincrement())
  name         String
  categoryId   Int
  category     Category      @relation(fields: [categoryId], references: [id])
  gender       String
  type         String
  price        Float
  material     String
  natureTheme  String
  description  String
  images       String
  stock        Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

// Login accounts (TICKET-118). role gates access: "owner" can reach
// everything, "staff" can view/edit Items and Categories but not
// Finance or Settings -- enforced in the API routes, not just the UI.
model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("staff")
  createdAt    DateTime      @default(now())
  activityLogs ActivityLog[]
}

// Business-wide profile and storefront preferences -- one row (id 1),
// shared by whoever is logged in with permission to see it. No longer
// holds login credentials; those live on User now (TICKET-118).
model Settings {
  id              Int      @id @default(1)
  businessName    String
  logoUrl         String?
  // Storefront-facing preferences -- no public storefront exists yet,
  // so these don't drive any live behavior; they're here so the
  // storefront has somewhere to read them from once it exists.
  currency        String   @default("USD")
  taxRatePercent  Float    @default(0)
  defaultGenders  String   @default("[\"men\",\"women\",\"unisex\"]")
  maintenanceMode Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

// Accountability trail (TICKET-119): who changed what. userName is a
// snapshot taken at the time of the action so log entries stay readable
// even after a staff account is removed -- userId is kept too (nullable,
// SET NULL on delete) for filtering by a still-existing user.
model ActivityLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String
  action     String
  entityType String
  entityId   Int
  timestamp  DateTime @default(now())
}

// Finance scope decision (TICKET-102): tracks sales and expenses, not
// inventory value (already shown on the Dashboard) and not orders/carts
// (no storefront exists yet, so sales are logged manually). `itemId` is
// optional and singular -- a transaction can reference at most one
// catalog item; multi-item orders are out of scope until there's an
// actual storefront generating them.
model Transaction {
  id          Int      @id @default(autoincrement())
  type        String
  amount      Float
  description String
  date        DateTime @default(now())
  itemId      Int?
  item        Item?    @relation(fields: [itemId], references: [id])
  createdAt   DateTime @default(now())
}
