# Local development (default if DATABASE_URL is unset):
# DATABASE_URL="file:./dev.db"

# Production (Turso): combine the database URL and auth token into one value,
# using libsql's ?authToken= query parameter. Get these from the Turso CLI/dashboard.
# DATABASE_URL="libsql://your-db-name.turso.io?authToken=your-auth-token"

# Signs the login session cookie so a user can't edit it client-side to
# impersonate a different account/role. Falls back to an insecure dev
# default if unset -- set a real random value in production.
# SESSION_SECRET="a-long-random-string"
